# Copiar a .env en el VPS. Las claves "anon" son públicas; NUNCA poner la service_role.
DOMINIO=tecnobear.app
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Captcha: clave del SITIO de Cloudflare Turnstile (la secreta va en Supabase, no acá)
TURNSTILE_SITE_KEY=
# procesos del motor para las descargas (≈ núcleos del VPS) y memoria máxima del servidor
EDEN3D_WORKERS=2
EDEN3D_MEMORIA=1500m
